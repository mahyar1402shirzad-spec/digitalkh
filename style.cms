* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Vazirmatn', sans-serif;
}

body {
  background: #0f0f1e;
  color: #fff;
  line-height: 1.8;
}

/* نوبار */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  background: rgba(15, 15, 30, 0.95);
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
  border-bottom: 1px solid #2a2a3e;
}

.logo {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(90deg, #ff6b6b, #a29bfe);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.navbar nav a {
  color: #fff;
  text-decoration: none;
  margin-right: 25px;
  transition: color 0.3s;
}

.navbar nav a:hover {
  color: #a29bfe;
}

/* Hero */
.hero {
  text-align: center;
  padding: 120px 20px;
  background: radial-gradient(circle at center, #1a1a3e 0%, #0f0f1e 70%);
}

.hero h1 {
  font-size: 48px;
  margin-bottom: 20px;
  background: linear-gradient(90deg, #ff6b6b, #a29bfe);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero p {
  font-size: 20px;
  color: #b0b0c0;
  margin-bottom: 30px;
}

.btn {
  display: inline-block;
  padding: 14px 32px;
  background: linear-gradient(90deg, #ff6b6b, #a29bfe);
  color: #fff;
  text-decoration: none;
  border-radius: 50px;
  font-weight: 600;
  transition: transform 0.3s, box-shadow 0.3s;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(162, 155, 254, 0.4);
}

/* بخش‌ها */
section {
  padding: 80px 40px;
  max-width: 1200px;
  margin: auto;
}

section h2 {
  text-align: center;
  font-size: 36px;
  margin-bottom: 50px;
  color: #fff;
}

/* گرید */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 25px;
}

/* کارت خدمات */
.card {
  background: #1a1a3e;
  border: 1px solid #2a2a4e;
  border-radius: 20px;
  padding: 30px;
  text-align: center;
  transition: transform 0.3s, border-color 0.3s;
}

.card:hover {
  transform: translateY(-10px);
  border-color: #a29bfe;
}

.card .icon {
  font-size: 50px;
  margin-bottom: 15px;
}

.card h3 {
  margin-bottom: 10px;
  color: #a29bfe;
}

.card p {
  color: #b0b0c0;
  font-size: 15px;
}

/* نمونه‌کارها */
.work {
  height: 180px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 600;
  color: #fff;
  transition: transform 0.3s;
  cursor: pointer;
}

.work:hover {
  transform: scale(1.05);
}

/* تماس */
.contact {
  text-align: center;
}

.contact p {
  color: #b0b0c0;
  margin-bottom: 30px;
}

.contact-links {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

/* فوتر */
footer {
  text-align: center;
  padding: 30px;
  background: #0a0a15;
  color: #666;
  border-top: 1px solid #2a2a3e;
}

/* موبایل */
@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 15px;
    padding: 15px;
  }
  .navbar nav a {
    margin: 0 10px;
    font-size: 14px;
  }
  .hero h1 {
    font-size: 32px;
  }
  section {
    padding: 50px 20px;
  }
  section h2 {
    font-size: 28px;
  }
}
